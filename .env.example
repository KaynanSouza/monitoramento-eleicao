# Copie para .env.local e ajuste. Variáveis EXPO_PUBLIC_* são embutidas no bundle do app.

# Host e ambiente da divulgação do TSE
EXPO_PUBLIC_TSE_BASE=https://resultados.tse.jus.br
EXPO_PUBLIC_TSE_AMBIENTE=oficial
EXPO_PUBLIC_TSE_CICLO=ele2026

# Simulado (pode estar desativado):
# EXPO_PUBLIC_TSE_BASE=https://resultados-sim.tse.jus.br
# EXPO_PUBLIC_TSE_AMBIENTE=simulado2026

# off = dados reais do TSE | replay = reproduz a apuração a partir de fixtures/ (sem rede)
EXPO_PUBLIC_MOCK=off
# Velocidade do replay em minutos simulados por minuto real (20: 5 h de apuração em 15 min)
EXPO_PUBLIC_REPLAY_SPEED=20
